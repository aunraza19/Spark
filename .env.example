# Copy to .env (which git ignores). Never commit real values.
SPARK_GEMINI_BACKEND=aistudio
SPARK_GEMINI_MODEL=gemini-3.5-flash-lite
# How hard the chat thinks: minimal, low, medium or high.
SPARK_GEMINI_THINKING=medium
GEMINI_API_KEY=
# For Vertex AI instead: SPARK_GEMINI_BACKEND=vertex, GOOGLE_CLOUD_PROJECT=, GOOGLE_CLOUD_LOCATION=global
